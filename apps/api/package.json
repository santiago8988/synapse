{
  "name": "@synapse/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "_comentario_build": "Construye @synapse/validators antes que la API. Los schemas de Zod son VALORES en runtime —a diferencia de @synapse/types, que es solo tipos y tsc borra— asi que el dist compilado hace un require real contra packages/validators/dist. Turbo ya ordena esto con dependsOn ^build cuando se corre `pnpm build` desde la raiz, pero el deploy construye solo la API y ahi validators quedaba sin compilar: el contenedor arrancaba y moria con MODULE_NOT_FOUND. Explicito aca funciona con cualquiera de los dos comandos.",
    "build": "pnpm --filter @synapse/validators build && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^6.2.0",
    "@synapse/types": "workspace:*",
    "@synapse/validators": "workspace:*",
    "mathjs": "^15.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3"
  }
}
