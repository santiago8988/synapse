DATABASE_URL="postgresql://user:password@localhost:5432/qualitab?schema=public"
REDIS_URL="redis://localhost:6379"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"

# Almacenamiento de archivos.
# Si las cuatro primeras estan cargadas se usa R2; si falta alguna se cae a
# disco local (uploads/), que solo sirve para desarrollo. En NODE_ENV
# production, arrancar sin R2 es un error: el filesystem es efimero y los PDFs
# son evidencia ISO.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Base publica de la API. Se usa para armar las URLs firmadas del backend local.
API_PUBLIC_URL="http://localhost:3001/api"

# Secreto para firmar las URLs de archivos del backend local. Si se omite se
# reutiliza JWT_SECRET.
STORAGE_SIGNING_SECRET=""
