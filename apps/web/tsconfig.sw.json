{
  // El service worker no corre en el DOM: necesita `lib: webworker`, que es
  // incompatible con `lib: dom` (redeclaran los mismos globals). Por eso vive
  // en su propio proyecto de TypeScript y se excluye del principal, en vez de
  // quedar sin tipar.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "webworker"],
    "types": []
  },
  "include": ["src/app/sw.ts", "src/lib/offline-cache.ts"],
  "exclude": ["node_modules"]
}
